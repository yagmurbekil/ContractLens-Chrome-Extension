# ContractLens Backend Configuration

# Server Port
PORT=3001

# Active LLM Provider: 'mock' | 'openai' | 'gemini' | 'anthropic'
LLM_PROVIDER=mock

# OpenAI Settings (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (if using gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Settings (if using anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Performance Safeguards
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
RATE_LIMIT_MAX_PER_MINUTE=30
